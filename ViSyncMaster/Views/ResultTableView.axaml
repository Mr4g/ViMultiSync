<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dataModel="clr-namespace:ViSyncMaster.DataModel"
             xmlns:viewModels="clr-namespace:ViSyncMaster.ViewModels"
			 xmlns:material="using:Material.Icons.Avalonia"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vms="using:ViewModelsSamples.Lines.Area"
             xmlns:styles="clr-namespace:Avalonia.Styling"
             x:Class="ViSyncMaster.ResultTableView"
             x:DataType="viewModels:ResultTableViewModel"
			 VerticalAlignment="Top">

	<UserControl.Styles>
		<!-- Styl dla tabeli -->
		<Style Selector="DataGrid">
			<Setter Property="Background" Value="#1D1F27"/>
			<Setter Property="BorderBrush" Value="#3C3F47"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="FontSize" Value="16"/>
		</Style>

		<!-- Styl dla nagłówków kolumn -->
		<Style Selector="DataGridColumnHeader">
			<Setter Property="Background" Value="#3A3F47"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="18"/>
		</Style>

		<!-- Styl dla komórek -->
		<Style Selector="DataGridCell">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="FontSize" Value="24"/>
			<Setter Property="TextBlock.TextAlignment" Value="Center"/>
		</Style>

		<!-- Zebra striping: co drugi wiersz inny odcień -->
		<Style Selector="DataGridRow:nth-child(odd)">
			<Setter Property="Background" Value="#24262F"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="DataGridRow:nth-child(even)">
			<Setter Property="Background" Value="#2D2F38"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<!-- Hover -->
		<Style Selector="DataGridRow:hover">
			<Setter Property="Background" Value="#3A3F47"/>
		</Style>
	</UserControl.Styles>



	<Grid>
		<!-- Definiowanie wierszy w Gridzie -->
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!-- Panel sterowania (przyciski, textbox, targety) -->
		<StackPanel Orientation="Vertical" Grid.Row="0" VerticalAlignment="Top" Grid.ColumnSpan="6">
				<StackPanel Orientation="Horizontal">
				<Button Content="ZM 1" Command="{Binding FilterShift1Command}"
						        Background="#0B0A0F"
								Foreground="WhiteSmoke"
								FontSize="18"
						        Margin="10, 5, 10, 5"
								FontWeight="Bold"/>
				<Button Content="ZM 2" Command="{Binding FilterShift2Command}"
						        Background="#0B0A0F"
								Foreground="WhiteSmoke"
								FontSize="18"
						        Margin="10, 5, 10, 5"
								FontWeight="Bold"/>
				<Button Content="ZM 3" Command="{Binding FilterShift3Command}"
								Background="#0B0A0F"
								Foreground="WhiteSmoke"
								FontSize="18"
								Margin="10, 5, 10, 5"
								FontWeight="Bold"/>
				<Button Content="ZM 3 WCZORAJ" Command="{Binding FilterYesterdayShift3Command}"
						        Background="#0B0A0F"
								Foreground="WhiteSmoke"
								FontSize="18"
						        Margin="10, 5, 10, 5"
								FontWeight="Bold"/>
					<Button Content="TYDZIEŃ" Command="{Binding FilterWholeWeekCommand}"
							        Background="#0B0A0F"
									Foreground="WhiteSmoke"
									FontSize="18"
								    Margin="10, 5, 10, 5"
									FontWeight="Bold"/>
					<TextBlock Text="{Binding SelectedShiftRangeInfo}"
							   VerticalAlignment="Center"
							   Margin="20,0,0,0"
							   Foreground="LightGray"
							   FontSize="16"
							   FontWeight="SemiBold"/>
				</StackPanel>

			<!-- Tabela wyników -->
			<DataGrid ItemsSource="{Binding GroupedResultList}" SelectedItem="{Binding SelectedResultRow, Mode=TwoWay}" AutoGenerateColumns="False" VerticalAlignment="Top"
					  CanUserResizeColumns="True" CanUserReorderColumns="True" IsReadOnly="true" MaxHeight="240"
					  CanUserSortColumns="True" GridLinesVisibility="None" RowHeight="40" Margin="10">
				<DataGrid.Columns>
					<DataGridTextColumn Header="ProductName" Binding="{Binding ProductNumber, Mode=OneWay}" Width="*"/>
					<DataGridTextColumn Header="Takt Time [s]" Binding="{Binding TaktTimeSeconds, StringFormat={}{0:0.###}}" Width="Auto"/>
					<DataGridTextColumn Header="Planned Qty" Binding="{Binding PlannedQty}" Width="Auto"/>
					<DataGridTextColumn Header="Actual Qty" Binding="{Binding ActualQty}" Width="Auto"/>
					<DataGridTextColumn Header="Expected Qty" Binding="{Binding ExpectedQty}" Width="Auto"/>
					<DataGridTextColumn Header="Start Time" Binding="{Binding StartTimeDisplay}" Width="Auto"/>
					<DataGridTextColumn Header="Planned End Time" Binding="{Binding PlannedEndTimeDisplay}" Width="Auto"/>
					<DataGridTextColumn Header="Difference" Binding="{Binding Difference}" Width="Auto"/>
					<DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
					<DataGridTemplateColumn Header="Progress" Width="220">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Grid ClipToBounds="True">
									<ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="18" Margin="2,0" />
									<TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0.#}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="WhiteSmoke"/>
								</Grid>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</StackPanel>


		<!-- Panel prawy: Wskaźniki kołowe -->
		<StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="30" VerticalAlignment="Center">
			<!-- Wiersz z dwoma wykresami kołowymi -->
			<Border CornerRadius="28" Background="#0B0A0F" HorizontalAlignment="Center">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsVisible ="false">
					<!-- Pierwszy wykres kołowy -->
					<StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="10">
						<lvc:PieChart
						Series="{Binding Series}"
						InitialRotation="135"
						Width="400"
						Height="400"
						MaxValue="{Binding Target}"
						LegendPosition="Bottom"
						LegendTextPaint="{Binding LegendTextPaint}"
						LegendTextSize="24"
						MaxAngle="270">
						</lvc:PieChart>
						<TextBlock Text="Target" HorizontalAlignment="Center" FontSize="16" Foreground="White"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</StackPanel>

		<!-- Tabela planu (ukryta: aby w widoku Result renderowała się tylko jedna główna tabela wyników) -->
		<ScrollViewer Grid.Row="3" Grid.Column="2" VerticalScrollBarVisibility="Auto" IsVisible="False">
			<DataGrid ItemsSource="{Binding HourlyPlan}" AutoGenerateColumns="False" RowHeight="48" MaxHeight="700"
						  IsReadOnly="True" GridLinesVisibility="None" Margin="10" Width="1100" 
						  VerticalAlignment="Stretch"
					  >
				<DataGrid.Columns>
					<DataGridTextColumn Header="Czas" Binding="{Binding Period}" Width="Auto"/>
					<DataGridTextColumn Header="Plan" Binding="{Binding ExpectedDisplay}" Width="Auto"/>
					<DataGridTemplateColumn Header="Wykon" Width="220">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Grid ClipToBounds="True">
									<Grid IsVisible="{Binding IsBreak, Converter={StaticResource InverseBoolConverter}}" ClipToBounds="True">
										<ProgressBar Minimum="0"
											 Maximum="100"
											 Value="{Binding ProgressPercent}"
											 HorizontalAlignment="Stretch"
											 Height="20"
											 Margin="0,2"
											 Foreground="Green"
											 Background="#1D1F27"
											 IsHitTestVisible="False"/>
										<!-- Tekst nad paskiem: zawsze czytelny, niezależnie od poziomu progresu -->
										<TextBlock Text="{Binding ProducedUnits}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="WhiteSmoke" FontWeight="SemiBold"/>
									</Grid>
									<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsBreak}">
										<TextBlock Text="{Binding ProducedUnits}" Margin="5,0,0,0"/>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTextColumn Header="Przestoje [min]" Binding="{Binding DowntimeDisplay}" Width="Auto"/>
					<DataGridTextColumn Header="Stracone [szt]" Binding="{Binding LostUnitsDisplay}" Width="Auto"/>
					<DataGridTextColumn Header="Efektywność [%]"
										Binding="{Binding EfficiencyDisplay}"
										Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</ScrollViewer>


		<!-- Panel prawy: Wskaźniki kołowe -->
		<StackPanel Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Orientation="Vertical" HorizontalAlignment="Center" Margin="10" VerticalAlignment="Center">
			<!-- Wiersz z dwoma wykresami kołowymi -->
			<Border CornerRadius="28" Background="#0B0A0F" HorizontalAlignment="Center">
				<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
					<!-- Pierwszy wykres kołowy -->
					<StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="5">
						<lvc:PieChart
							Series="{Binding SeriesEfficiency}"
							VisualElements="{Binding VisualElements}"
							InitialRotation="-225"
							Width="400"
							Height="400"
							MaxValue="200"
							MaxAngle="270">
						</lvc:PieChart>
						<TextBlock Text="Wydajność [%]" HorizontalAlignment="Center" FontSize="16" Foreground="White"/>
					</StackPanel>
					<!-- Panel sterowania (przyciski, textbox, targety) -->
						<Border CornerRadius="10" Background="#0B0A0F" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center">
							<StackPanel Orientation="Vertical">
								<StackPanel Orientation="Horizontal">
									<TextBox Width="120" Height="40" Margin="6"
											 Text="{Binding PlannedQtyInput, Mode=TwoWay}"
											 Watermark="Planned Qty"
											 HorizontalAlignment="Center"
											 FontSize="16"
											 Padding="8"
											 Background="DarkGray"
											 Foreground="Black"
											 BorderThickness="2"/>
									<Button Content="Zapisz plan qty" Margin="6" Command="{Binding SaveSelectedProductPlanCommand}" Background="OrangeRed" Foreground="WhiteSmoke"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal">
									<TextBox Width="120" Height="40" Margin="6"
											 Text="{Binding ManualTaktTimeInput, Mode=TwoWay}"
											 Watermark="Takt [s]"
											 HorizontalAlignment="Center"
											 FontSize="16"
											 Padding="8"
											 Background="DarkGray"
											 Foreground="Black"
											 BorderThickness="2"/>
									<Button Content="Zapisz takt do CSV" Margin="6" Command="{Binding SaveMissingTaktTimeCommand}" Background="#6A8DFF" Foreground="WhiteSmoke"/>
								</StackPanel>
								<TextBlock Text="{Binding PlanEditorMessage}" Foreground="LightGray" Margin="8,2,8,8"/>
								<!-- Legacy fallback: global target -->
								<StackPanel Orientation="Horizontal">
									<TextBox Width="100" Height="40" Margin="6"
											 Text="{Binding Target, Mode=TwoWay}"
											 Watermark="Fallback target"
											 FontSize="14"
											 Padding="8"
											 Background="DarkGray"
											 Foreground="Black"
											 BorderThickness="2"/>
									<Button Content="Zapisz Target" Margin="6" Command="{Binding SaveTargetCommand}" Background="Gray" Foreground="WhiteSmoke"/>
								</StackPanel>
							</StackPanel>
						</Border>
					</StackPanel>
				</Border>
			</StackPanel>

		<!-- Panel prawy: Wskaźniki kołowe -->
		<!--
		<StackPanel Grid.Row="2" Grid.Column="5" Orientation="Vertical" HorizontalAlignment="Center" Margin="30">
			-->
		<!-- Wiersz z dwoma wykresami kołowymi -->
		<!--
			<Border CornerRadius="28" Background="#0B0A0F" HorizontalAlignment="Center">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					-->
		<!-- Pierwszy wykres kołowy -->
		<!--
					<StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="10">
						<lvc:PieChart
							Series="{Binding SeriesExpectedEfficiency}"
							InitialRotation="135"
							Width="400"
							Height="400"
							MaxValue="100"
							MaxAngle="270">
						</lvc:PieChart>
						<TextBlock Text="Oczekiwana realizacja targetu [%]" HorizontalAlignment="Center" FontSize="16" Foreground="White"/>
					</StackPanel>
				</StackPanel>
			</Border>
                </StackPanel>-->
	</Grid>

</UserControl>

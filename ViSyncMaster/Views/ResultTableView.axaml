<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dataModel="clr-namespace:ViSyncMaster.DataModel"
             xmlns:viewModels="clr-namespace:ViSyncMaster.ViewModels"
			 xmlns:material="using:Material.Icons.Avalonia"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vms="using:ViewModelsSamples.Lines.Area"
             xmlns:styles="clr-namespace:Avalonia.Styling"
             x:Class="ViSyncMaster.ResultTableView"
             x:DataType="viewModels:ResultTableViewModel"
			 VerticalAlignment="Top">

	<UserControl.Styles>
		<!-- Styl dla tabeli -->
		<Style Selector="DataGrid">
			<Setter Property="Background" Value="#1D1F27"/>
			<Setter Property="BorderBrush" Value="#3C3F47"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="FontSize" Value="16"/>
		</Style>

		<!-- Styl dla nagłówków kolumn -->
		<Style Selector="DataGridColumnHeader">
			<Setter Property="Background" Value="#3A3F47"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="18"/>
		</Style>

		<!-- Styl dla komórek -->
		<Style Selector="DataGridCell">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="TextBlock.TextAlignment" Value="Center"/>
		</Style>

		<!-- Zebra striping: co drugi wiersz inny odcień -->
		<Style Selector="DataGridRow:nth-child(odd)">
			<Setter Property="Background" Value="#24262F"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="DataGridRow:nth-child(even)">
			<Setter Property="Background" Value="#2D2F38"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<!-- Hover -->
		<Style Selector="DataGridRow:hover">
			<Setter Property="Background" Value="#3A3F47"/>
		</Style>
	</UserControl.Styles>



	<Grid>
		<!-- Definiowanie wierszy w Gridzie -->
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="4*" />
			<ColumnDefinition Width="12" />
			<ColumnDefinition Width="1.45*" />
		</Grid.ColumnDefinitions>

		<!-- Panel sterowania (przyciski, textbox, targety) -->
		<StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
				<StackPanel Orientation="Horizontal">
				<Button Content="ZM 1" Command="{Binding FilterShift1Command}"
						        Background="#0B0A0F"
								Foreground="WhiteSmoke"
								FontSize="18"
						        Margin="10, 5, 10, 5"
								FontWeight="Bold"/>
				<Button Content="ZM 2" Command="{Binding FilterShift2Command}"
						        Background="#0B0A0F"
								Foreground="WhiteSmoke"
								FontSize="18"
						        Margin="10, 5, 10, 5"
								FontWeight="Bold"/>
				<Button Content="ZM 3" Command="{Binding FilterShift3Command}"
								Background="#0B0A0F"
								Foreground="WhiteSmoke"
								FontSize="18"
								Margin="10, 5, 10, 5"
								FontWeight="Bold"/>
				<Button Content="ZM 3 WCZORAJ" Command="{Binding FilterYesterdayShift3Command}"
						        Background="#0B0A0F"
								Foreground="WhiteSmoke"
								FontSize="18"
						        Margin="10, 5, 10, 5"
								FontWeight="Bold"/>
					<Button Content="TYDZIEŃ" Command="{Binding FilterWholeWeekCommand}"
							        Background="#0B0A0F"
									Foreground="WhiteSmoke"
									FontSize="18"
								    Margin="10, 5, 10, 5"
									FontWeight="Bold"/>
					<TextBlock Text="{Binding SelectedShiftRangeInfo}"
							   VerticalAlignment="Center"
							   Margin="20,0,0,0"
							   Foreground="LightGray"
							   FontSize="16"
							   FontWeight="SemiBold"/>
				</StackPanel>

			<!-- Górna tabela ogólna (produktowa) -->
			<DataGrid ItemsSource="{Binding GroupedResultList}" SelectedItem="{Binding SelectedResultRow, Mode=TwoWay}" AutoGenerateColumns="False"
					  CanUserResizeColumns="True" CanUserReorderColumns="True" IsReadOnly="True"
					  CanUserSortColumns="True" GridLinesVisibility="None" RowHeight="40" MaxHeight="180" Margin="10,10,10,4">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Produkt" Binding="{Binding ProductNumber}" Width="*"/>
					<DataGridTextColumn Header="Pass" Binding="{Binding ShiftCounterPass}" Width="Auto"/>
					<DataGridTextColumn Header="Fail" Binding="{Binding ShiftCounterFail}" Width="Auto"/>
					<DataGridTextColumn Header="Takt [s]" Binding="{Binding TaktTimeSeconds, StringFormat={}{0:0.###}}" Width="Auto"/>
					<DataGridTextColumn Header="Target" Binding="{Binding PlannedQty}" Width="Auto"/>
					<DataGridTextColumn Header="Actual" Binding="{Binding ActualQty}" Width="Auto"/>
					<DataGridTextColumn Header="Expected" Binding="{Binding ExpectedQty}" Width="Auto"/>
					<DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
				</DataGrid.Columns>
			</DataGrid>

			<!-- Dolna tabela planu godzinowego -->
			<DataGrid ItemsSource="{Binding HourlyPlan}" AutoGenerateColumns="False" RowHeight="46" MaxHeight="680"
					  IsReadOnly="True" GridLinesVisibility="None" Margin="10,4,10,10" VerticalAlignment="Stretch">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Czas" Binding="{Binding Period}" Width="Auto"/>
					<DataGridTextColumn Header="Plan" Binding="{Binding ExpectedDisplay}" Width="Auto"/>
					<DataGridTemplateColumn Header="Wykon" Width="190">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Grid ClipToBounds="True">
									<Grid IsVisible="{Binding IsBreak, Converter={StaticResource InverseBoolConverter}}" ClipToBounds="True">
										<ProgressBar Minimum="0"
											 Maximum="100"
											 Value="{Binding ProgressPercent}"
											 HorizontalAlignment="Stretch"
											 Height="20"
											 Margin="0,2"
											 Foreground="{Binding ProgressBrush}"
											 Background="#1D1F27"
											 IsHitTestVisible="False"/>
										<TextBlock Text="{Binding ProducedUnits}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="WhiteSmoke" FontWeight="SemiBold"/>
									</Grid>
									<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsBreak}">
										<TextBlock Text="{Binding ProducedUnits}" Margin="5,0,0,0"/>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTextColumn Header="Przestoje [min]" Binding="{Binding DowntimeDisplay}" Width="Auto"/>
					<DataGridTextColumn Header="Stracone [szt]" Binding="{Binding LostUnitsDisplay}" Width="Auto"/>
					<DataGridTextColumn Header="Efektywność [%]" Binding="{Binding EfficiencyDisplay}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</StackPanel>


		<!-- Panel prawy: Wydajność i podstawowe dane -->
		<StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="6" Orientation="Vertical" HorizontalAlignment="Stretch" Margin="8,10,10,10" VerticalAlignment="Top">
			<!-- Wiersz z dwoma wykresami kołowymi -->
			<Border CornerRadius="28" Background="#0B0A0F" HorizontalAlignment="Center">
				<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
					<!-- Pierwszy wykres kołowy -->
					<StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="8,8,8,4">
						<lvc:PieChart
							Series="{Binding SeriesEfficiency}"
							VisualElements="{Binding VisualElements}"
							InitialRotation="-225"
							Width="330"
							Height="330"
							MaxValue="200"
							MaxAngle="270">
						</lvc:PieChart>
						<TextBlock Text="Wydajność [%]" HorizontalAlignment="Center" FontSize="16" Foreground="White" FontWeight="SemiBold"/>
					</StackPanel>
					<!-- Panel informacji -->
					<Border CornerRadius="10" Background="#11131A" Margin="8,4,8,10" VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="10">
						<StackPanel Orientation="Vertical" Spacing="4">
							<TextBlock Text="Aktualny produkt (raw):" Foreground="#AAB3C2" FontSize="12"/>
							<TextBlock Text="{Binding CurrentProductRawName}" Foreground="WhiteSmoke" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxHeight="36"/>
							<TextBlock Text="Numer produktu: " Foreground="#AAB3C2" FontSize="12"/>
							<TextBlock Text="{Binding CurrentProductNumber}" Foreground="WhiteSmoke" FontWeight="SemiBold" FontSize="18"/>
							<Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
								<TextBlock Grid.Column="0" Text="Takt:" Foreground="#AAB3C2" FontSize="12" Margin="0,0,6,0"/>
								<TextBlock Grid.Column="1" Text="{Binding CurrentProductTaktInfo}" Foreground="WhiteSmoke" FontWeight="SemiBold"/>
							</Grid>
							<Grid ColumnDefinitions="Auto,*">
								<TextBlock Grid.Column="0" Text="Target:" Foreground="#AAB3C2" FontSize="12" Margin="0,0,6,0"/>
								<TextBlock Grid.Column="1" Text="{Binding CurrentProductTargetInfo}" Foreground="WhiteSmoke" FontWeight="SemiBold"/>
							</Grid>
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,6,0,0">
								<TextBox Width="110" Height="36" Text="{Binding PlannedQtyInput, Mode=TwoWay}" Watermark="Target"
										 FontSize="14" Padding="6" Background="DarkGray" Foreground="Black" BorderThickness="2"/>
								<Button Content="Zapisz Target" Margin="8,0,0,0" Command="{Binding SaveSelectedProductPlanCommand}"
										Background="#FF5A1F" Foreground="WhiteSmoke" FontWeight="Bold"/>
							</StackPanel>
						</StackPanel>
					</Border>
					</StackPanel>
				</Border>
			</StackPanel>

			<!-- Panel prawy: Wskaźniki kołowe -->
		<!--
		<StackPanel Grid.Row="2" Grid.Column="5" Orientation="Vertical" HorizontalAlignment="Center" Margin="30">
			-->
		<!-- Wiersz z dwoma wykresami kołowymi -->
		<!--
			<Border CornerRadius="28" Background="#0B0A0F" HorizontalAlignment="Center">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					-->
		<!-- Pierwszy wykres kołowy -->
		<!--
					<StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="10">
						<lvc:PieChart
							Series="{Binding SeriesExpectedEfficiency}"
							InitialRotation="135"
							Width="400"
							Height="400"
							MaxValue="100"
							MaxAngle="270">
						</lvc:PieChart>
						<TextBlock Text="Oczekiwana realizacja targetu [%]" HorizontalAlignment="Center" FontSize="16" Foreground="White"/>
					</StackPanel>
				</StackPanel>
			</Border>
                </StackPanel>-->
		<!-- Osobny dialog brakującego takt time -->
		<Border IsVisible="{Binding IsMissingTaktDialogVisible}"
				Background="#CC000000"
				Grid.Row="0"
				Grid.RowSpan="6"
				Grid.Column="0"
				Grid.ColumnSpan="3">
			<Border Width="460"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					CornerRadius="12"
					Background="#1D1F27"
					BorderBrush="#3C3F47"
					BorderThickness="1"
					Padding="16">
				<StackPanel>
					<TextBlock Text="Brakuje takt time dla produktu:" Foreground="WhiteSmoke" FontSize="18" FontWeight="SemiBold"/>
					<TextBlock Text="{Binding CurrentProductNumber}" Foreground="Orange" FontSize="24" FontWeight="Bold" Margin="0,4,0,8"/>
					<TextBox Text="{Binding ManualTaktTimeInput, Mode=TwoWay}"
							 Watermark="Takt [s]"
							 Height="40"
							 FontSize="16"
							 Padding="8"
							 Background="DarkGray"
							 Foreground="Black"
							 BorderThickness="2"/>
					<TextBlock Text="{Binding PlanEditorMessage}" Foreground="LightGray" Margin="0,8,0,0"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
						<Button Content="Anuluj" Margin="0,0,8,0" Command="{Binding CancelMissingTaktDialogCommand}" Background="Gray" Foreground="WhiteSmoke"/>
						<Button Content="Zapisz" Command="{Binding SaveMissingTaktTimeCommand}" Background="#6A8DFF" Foreground="WhiteSmoke"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>
		<Border IsVisible="{Binding IsMissingTargetDialogVisible}"
				Background="#CC000000"
				Grid.Row="0"
				Grid.RowSpan="6"
				Grid.Column="0"
				Grid.ColumnSpan="3">
			<Border Width="460"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					CornerRadius="12"
					Background="#1D1F27"
					BorderBrush="#3C3F47"
					BorderThickness="1"
					Padding="16">
				<StackPanel>
					<TextBlock Text="Brakuje targetu dla produktu:" Foreground="WhiteSmoke" FontSize="18" FontWeight="SemiBold"/>
					<TextBlock Text="{Binding CurrentProductNumber}" Foreground="Orange" FontSize="24" FontWeight="Bold" Margin="0,4,0,8"/>
					<TextBox Text="{Binding PlannedQtyInput, Mode=TwoWay}"
							 Watermark="Target [szt]"
							 Height="40"
							 FontSize="16"
							 Padding="8"
							 Background="DarkGray"
							 Foreground="Black"
							 BorderThickness="2"/>
					<TextBlock Text="{Binding PlanEditorMessage}" Foreground="LightGray" Margin="0,8,0,0"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
						<Button Content="Anuluj" Margin="0,0,8,0" Command="{Binding CancelMissingTargetDialogCommand}" Background="Gray" Foreground="WhiteSmoke"/>
						<Button Content="Zapisz" Command="{Binding SaveSelectedProductPlanCommand}" Background="OrangeRed" Foreground="WhiteSmoke"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>
	</Grid>

</UserControl>
